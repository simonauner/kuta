# 1Password references for scripts/upload-map.sh, never values. The item kuta-map-r2 in the vault Development holds an
# R2 API token limited to Object Read & Write on the map bucket, plus the account id and bucket name (see README, Karta).
KUTA_MAP_ACCOUNT_ID=op://Development/kuta-map-r2/account-id
KUTA_MAP_BUCKET=op://Development/kuta-map-r2/bucket
RCLONE_CONFIG_R2_ACCESS_KEY_ID=op://Development/kuta-map-r2/access-key-id
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=op://Development/kuta-map-r2/secret-access-key
